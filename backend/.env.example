# AI 视频总结配置（复制为 .env 并填入真实值；.env 不要提交到仓库）

# 必填：大模型 API Key（DeepSeek 或智谱，二选一）
LLM_API_KEY=

# 二选一配置：DeepSeek（默认）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 二选一配置：智谱 GLM（用上面那组时注释掉这两行）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 免费 IP 每日总结次数（手动测试时可调大，如 100）
AI_DAILY_LIMIT=3

# 仅本地前端联调时启用（返回固定模拟数据，不调用真实模型，上线前必须去掉）
# LLM_PROVIDER=mock

# ---------- Stripe 支付（Test Mode 密钥，均以 sk_test_/whsec_ 开头） ----------
# 不填 STRIPE_API_KEY 时自动回退 Mock 模拟支付（本地无密钥也能全流程联调）
STRIPE_API_KEY=
# Webhook 签名密钥：本地用 stripe listen 输出的 whsec_；上线用 Dashboard endpoint 的 whsec_
STRIPE_WEBHOOK_SECRET=
# 支付成功回跳地址的站点基地址（必须绝对 URL）：本地默认后端 8000；
# Vite 联调改 http://localhost:5173；上线填 https://你的域名
SITE_BASE_URL=http://127.0.0.1:8000
# 生产 HTTPS 部署后设为 1（登录 cookie 附加 Secure 属性）
COOKIE_SECURE=0
# 如有独立域名的 H5 需要跨域调用 API 时填写，逗号分隔；留空=仅同源
ALLOWED_ORIGINS=
# SEO需要网站地址
SITE_URL=
