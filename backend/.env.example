# AI 视频总结配置（复制为 .env 并填入真实值；.env 不要提交到仓库）

# 必填：大模型 API Key（DeepSeek 或智谱，二选一）
LLM_API_KEY=

# 二选一配置：DeepSeek（默认）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 二选一配置：智谱 GLM（用上面那组时注释掉这两行）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 免费 IP 每日总结次数（手动测试时可调大，如 100）
AI_DAILY_LIMIT=3

# YouTube 年龄门等需登录场景：从本机浏览器读 Cookie（可选，本地部署用）
# 可选值：edge / chrome / firefox 等，留空不启用；注意浏览器运行时可能读不到（锁库）
# YTDLP_COOKIES_FROM_BROWSER=edge

# 仅本地前端联调时启用（返回固定模拟数据，不调用真实模型，上线前必须去掉）
# LLM_PROVIDER=mock
